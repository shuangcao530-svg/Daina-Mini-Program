page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #171f32;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
textarea,
button,
image {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border: 0;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.7) 0%, rgba(245, 247, 251, 0) 320rpx),
    #f5f7fb;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-title {
  color: #171f32;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #7a8497;
  font-size: 24rpx;
  line-height: 1.45;
}

.card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 42rpx rgba(25, 32, 47, 0.08);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.muted {
  color: #7a8497;
}

.mini-label {
  color: #8a93a6;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #333d52;
  font-size: 25rpx;
  font-weight: 800;
}

.input,
.textarea,
.picker {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #dfe5ee;
  border-radius: 14rpx;
  background: #ffffff;
  color: #171f32;
  font-size: 28rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(23, 31, 50, 0.03);
}

.textarea {
  height: 168rpx;
  line-height: 1.55;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.primary-btn,
.ghost-btn,
.danger-btn,
.dark-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #0e9f7f 0%, #1d7ff0 100%);
  box-shadow: 0 18rpx 32rpx rgba(14, 159, 127, 0.2);
}

.dark-btn {
  color: #ffffff;
  background: #171f32;
  box-shadow: 0 18rpx 32rpx rgba(23, 31, 50, 0.18);
}

.ghost-btn {
  color: #0b846b;
  background: #eafaf5;
  border: 1rpx solid #bfe9dc;
}

.danger-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #ef5746 0%, #f59d34 100%);
  box-shadow: 0 16rpx 30rpx rgba(239, 87, 70, 0.18);
}

.button-icon {
  margin-right: 10rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.tag,
.status-tag,
.info-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
  white-space: nowrap;
}

.tag {
  color: #0b846b;
  background: #eafaf5;
}

.status-pending {
  color: #0b846b;
  background: #eafaf5;
}

.status-accepted {
  color: #2166d1;
  background: #edf4ff;
}

.status-picked {
  color: #b86b00;
  background: #fff5df;
}

.status-delivering {
  color: #7a3de0;
  background: #f4efff;
}

.status-done {
  color: #64748b;
  background: #eef2f6;
}

.status-cancelled {
  color: #c24135;
  background: #fff0ed;
}

.status-confirming {
  color: #d97706;
  background: #fffbeb;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.thumb,
.upload-box {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 14rpx;
  background: #eef2f6;
}

.thumb {
  object-fit: cover;
}

.upload-box {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #9fcbbb;
  color: #0b846b;
  font-size: 48rpx;
  font-weight: 700;
}

.route-stack {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.route-stack::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 28rpx;
  bottom: 28rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #0e9f7f, #ef5746);
}

.route-point {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.route-dot {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  margin-top: 4rpx;
  border: 7rpx solid #ffffff;
  border-radius: 50%;
  background: #0e9f7f;
  box-shadow: 0 0 0 1rpx rgba(14, 159, 127, 0.28), 0 8rpx 16rpx rgba(14, 159, 127, 0.18);
}

.route-dot.end {
  background: #ef5746;
  box-shadow: 0 0 0 1rpx rgba(239, 87, 70, 0.28), 0 8rpx 16rpx rgba(239, 87, 70, 0.18);
}

.route-label {
  display: block;
  color: #8a93a6;
  font-size: 22rpx;
  font-weight: 800;
}

.route-addr {
  display: block;
  margin-top: 4rpx;
  color: #171f32;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
}

.price {
  color: #e97828;
  font-size: 38rpx;
  font-weight: 900;
  white-space: nowrap;
}

.empty {
  padding: 58rpx 34rpx;
  text-align: center;
}

.empty-mark {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 22rpx;
  border-radius: 16rpx;
  background: #171f32;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 900;
}

.empty-title {
  margin-bottom: 10rpx;
  color: #171f32;
  font-size: 34rpx;
  font-weight: 900;
}
