<view class="page detail-page" wx:if="{{order}}">
  <view class="receipt-head">
    <view class="receipt-top">
      <view>
        <text class="detail-kicker">ORDER DETAIL</text>
        <view class="detail-title">{{order.title}}</view>
      </view>
      <text class="status-tag status-{{order.statusKey}}">{{order.status}}</text>
    </view>
    <view class="receipt-meta">
      <text>#{{order.orderNo || order.id}}</text>
      <text class="price">¥{{order.fee}}</text>
    </view>
  </view>

  <view class="section route-card">
    <view class="section-head compact">
      <view>
        <view class="section-title">配送路线</view>
        <text class="section-subtitle">{{order.type}} / {{order.urgency}}</text>
      </view>
    </view>
    <view class="route-stack">
      <view class="route-point">
        <view class="route-dot"></view>
        <view>
          <text class="route-label">取件</text>
          <text class="route-addr">{{order.from}}</text>
        </view>
      </view>
      <view class="route-point">
        <view class="route-dot end"></view>
        <view>
          <text class="route-label">送达</text>
          <text class="route-addr">{{order.to}}</text>
        </view>
      </view>
    </view>
    <view class="detail-info">
      <view wx:if="{{order.pickupCode}}" class="info-line">
        <text class="info-label">取件码</text>
        <text class="info-value">{{order.pickupCode}}</text>
      </view>
      <view class="info-line">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.note || "无"}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-title">照片凭证</view>
        <text class="section-subtitle">下单、取件、送达三段留痕</text>
      </view>
    </view>

    <view class="proof-card">
      <view class="proof-head">
        <text class="proof-title">下单前</text>
        <text class="mini-label">{{order.userImages.length}} 张</text>
      </view>
      <view wx:if="{{order.userImages.length}}" class="image-grid">
        <image wx:for="{{order.userImages}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" bindtap="preview" data-list="userImages" data-src="{{item}}" />
      </view>
      <view wx:else class="proof-empty">暂无照片</view>
    </view>

    <view class="proof-card">
      <view class="proof-head">
        <text class="proof-title">已取件</text>
        <text class="mini-label">{{order.pickupImages.length}} 张</text>
      </view>
      <view wx:if="{{order.pickupImages.length}}" class="image-grid">
        <image wx:for="{{order.pickupImages}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" bindtap="preview" data-list="pickupImages" data-src="{{item}}" />
      </view>
      <view wx:else class="proof-empty">等待上传</view>
    </view>

    <view class="proof-card">
      <view class="proof-head">
        <text class="proof-title">已送达</text>
        <text class="mini-label">{{order.deliveryImages.length}} 张</text>
      </view>
      <view wx:if="{{order.deliveryImages.length}}" class="image-grid">
        <image wx:for="{{order.deliveryImages}}" wx:key="*this" class="thumb" src="{{item}}" mode="aspectFill" bindtap="preview" data-list="deliveryImages" data-src="{{item}}" />
      </view>
      <view wx:else class="proof-empty">等待上传</view>
    </view>
  </view>

  <view class="section timeline-card">
    <view class="section-title">时间线</view>
    <view class="timeline">
      <view wx:for="{{order.timeline}}" wx:key="label" class="timeline-item">
        <view class="timeline-dot"></view>
        <view>
          <view class="timeline-label">{{item.label}}</view>
          <view class="muted timeline-time">{{item.time}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{order.canConfirm}}" class="section">
    <button class="primary-btn confirm-btn" bindtap="confirmOrder">
      <text class="button-icon">✓</text>确认完成，报酬到账跑腿员
    </button>
  </view>
</view>

<view class="page detail-page" wx:else>
  <view class="empty card">
    <view class="empty-mark">...</view>
    <view class="empty-title">订单加载中</view>
    <view class="muted">正在获取订单详情</view>
  </view>
</view>
