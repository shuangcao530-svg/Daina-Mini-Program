<view class="page orders-page">
  <view class="orders-head">
    <view>
      <text class="orders-kicker">MY ORDERS</text>
      <view class="orders-title">我的订单</view>
      <view class="orders-copy">当前筛选：{{activeFilter}}</view>
    </view>
    <button class="dark-btn head-btn" bindtap="goCreate">
      <text class="button-icon">+</text>发布
    </button>
  </view>

  <view class="filter-bar">
    <view wx:for="{{filters}}" wx:key="*this" class="filter {{activeFilter === item ? 'active' : ''}}" bindtap="setFilter" data-value="{{item}}">
      {{item}}
    </view>
  </view>

  <view wx:if="{{displayOrders.length === 0}}" class="empty card">
    <view class="empty-mark">0</view>
    <view class="empty-title">暂无订单</view>
    <view class="muted">发布一个任务后，可以在这里追踪进度。</view>
    <button class="primary-btn empty-action" bindtap="goCreate">发布任务</button>
  </view>

  <view wx:for="{{displayOrders}}" wx:key="id" class="order-card" bindtap="goDetail" data-id="{{item.id}}">
    <view class="order-head">
      <view class="order-title-wrap">
        <text class="type-icon">{{item.typeIcon}}</text>
        <view>
          <view class="order-title">{{item.title}}</view>
          <view class="order-no">#{{item.orderNo || item.id}}</view>
        </view>
      </view>
      <text class="status-tag status-{{item.statusKey}}">{{item.status}}</text>
    </view>

    <view class="route-stack order-route">
      <view class="route-point">
        <view class="route-dot"></view>
        <view>
          <text class="route-label">取件</text>
          <text class="route-addr">{{item.from}}</text>
        </view>
      </view>
      <view class="route-point">
        <view class="route-dot end"></view>
        <view>
          <text class="route-label">送达</text>
          <text class="route-addr">{{item.to}}</text>
        </view>
      </view>
    </view>

    <view class="order-foot">
      <view class="order-tags">
        <text class="info-tag urgency-{{item.urgentKey}}">{{item.urgent || item.urgency}}</text>
        <text class="info-tag type-tag">{{item.type}}</text>
      </view>
      <text class="price">¥{{item.fee}}</text>
    </view>
  </view>
</view>
