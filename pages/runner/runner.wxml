<view class="page runner-page">
  <view class="runner-hero">
    <view class="runner-hero-top">
      <view>
        <text class="runner-kicker">RUNNER DESK</text>
        <view class="runner-title">跑腿工作台</view>
        <view class="runner-copy">抢单、取件、配送、结算都在这里处理。</view>
      </view>
      <view class="runner-live">
        <text class="live-dot"></text>
        <text>在线</text>
      </view>
    </view>

    <view class="head-stats">
      <view class="head-stat">
        <text class="head-stat-num">{{stats.available}}</text>
        <text class="head-stat-label">可接</text>
      </view>
      <view class="head-stat">
        <text class="head-stat-num">{{stats.today}}</text>
        <text class="head-stat-label">今日完成</text>
      </view>
      <view class="head-stat">
        <text class="head-stat-num">¥{{stats.earned}}</text>
        <text class="head-stat-label">今日收入</text>
      </view>
    </view>
  </view>

  <view class="filter-bar">
    <view wx:for="{{filters}}" wx:key="*this" class="filter {{activeFilter === item ? 'active' : ''}}" bindtap="setFilter" data-value="{{item}}">
      {{item}}
    </view>
  </view>

  <view wx:if="{{displayOrders.length === 0}}" class="empty card">
    <view class="empty-mark">0</view>
    <view class="empty-title">暂无匹配订单</view>
    <view class="muted">换个筛选条件看看。</view>
  </view>

  <view wx:for="{{displayOrders}}" wx:key="id" class="runner-card">
    <view class="runner-card-head">
      <view class="card-title-wrap">
        <text class="order-type-icon">{{item.typeIcon}}</text>
        <view>
          <view class="order-title">{{item.title}}</view>
          <view class="order-meta">#{{item.orderNo || item.id}}</view>
        </view>
      </view>
      <text class="status-tag status-{{item.statusKey}}">{{item.status}}</text>
    </view>

    <view class="route-stack runner-route">
      <view class="route-point">
        <view class="route-dot"></view>
        <view>
          <text class="route-label">取件</text>
          <text class="route-addr">{{item.from}}</text>
        </view>
      </view>
      <view class="route-point">
        <view class="route-dot end"></view>
        <view>
          <text class="route-label">送达</text>
          <text class="route-addr">{{item.to}}</text>
        </view>
      </view>
    </view>

    <view class="runner-card-foot">
      <view class="runner-tags">
        <text class="info-tag urgency-{{item.urgentKey}}">{{item.urgent || item.urgency}}</text>
        <text class="info-tag type-tag">{{item.type}}</text>
        <text wx:if="{{item.pickupCode}}" class="code-tag">码 {{item.pickupCode}}</text>
      </view>
      <text class="price">¥{{item.fee}}</text>
    </view>

    <view class="action-row">
      <button wx:if="{{item.status === '待接单'}}" class="primary-btn mini" bindtap="accept" data-id="{{item.id}}">
        <text class="button-icon">+</text>抢单
      </button>
      <button wx:elif="{{item.status === '已接单'}}" class="ghost-btn mini" bindtap="uploadPickup" data-id="{{item.id}}">
        <text class="button-icon">拍</text>取件照
      </button>
      <button wx:elif="{{item.status === '已取件'}}" class="dark-btn mini" bindtap="startDelivery" data-id="{{item.id}}">
        <text class="button-icon">→</text>开始配送
      </button>
      <button wx:elif="{{item.status === '配送中'}}" class="primary-btn mini accent-btn" bindtap="uploadDelivery" data-id="{{item.id}}">
        <text class="button-icon">✓</text>送达照
      </button>
      <button wx:else class="ghost-btn mini" bindtap="goDetail" data-id="{{item.id}}">
        查看详情
      </button>
    </view>
  </view>
</view>
