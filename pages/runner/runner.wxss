.runner-page {
  padding-top: 24rpx;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
}

.runner-hero {
  padding: 32rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background:
    linear-gradient(145deg, rgba(29, 127, 240, 0.76) 0%, rgba(29, 127, 240, 0) 42%),
    linear-gradient(135deg, #151a2d 0%, #27354f 52%, #0e9f7f 100%);
  box-shadow: 0 22rpx 50rpx rgba(23, 31, 50, 0.2);
}

.runner-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.runner-kicker {
  color: rgba(255, 255, 255, 0.64);
  font-size: 22rpx;
  font-weight: 900;
}

.runner-title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.12;
}

.runner-copy {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 24rpx;
}

.runner-live {
  min-height: 46rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.13);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7cf2ce;
}

.head-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 28rpx;
}

.head-stat {
  min-height: 118rpx;
  padding: 18rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
}

.head-stat-num {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.head-stat-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  font-weight: 800;
}

.filter-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin: 22rpx 0;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #e9eef5;
}

.filter {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #687386;
  font-size: 24rpx;
  font-weight: 900;
}

.filter.active {
  color: #ffffff;
  background: #171f32;
  box-shadow: 0 12rpx 22rpx rgba(23, 31, 50, 0.14);
}

.runner-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border: 1rpx solid #e4eaf2;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(25, 32, 47, 0.07);
}

.runner-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-title-wrap {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.order-type-icon {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #ffffff;
  background: #171f32;
  font-size: 26rpx;
  font-weight: 900;
}

.order-title {
  max-width: 390rpx;
  color: #171f32;
  font-size: 32rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-meta {
  margin-top: 6rpx;
  color: #8a93a6;
  font-size: 22rpx;
}

.runner-route {
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
}

.runner-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1f6;
}

.runner-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.type-tag {
  color: #333d52;
  background: #eef2f6;
}

.urgency-normal {
  color: #64748b;
  background: #eef2f6;
}

.urgency-urgent {
  color: #c24135;
  background: #fff0ed;
}

.code-tag {
  min-height: 42rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  background: #fff5df;
  color: #b86b00;
  font-size: 23rpx;
  font-weight: 900;
}

.action-row {
  margin-top: 22rpx;
}

.mini {
  width: 100%;
  min-height: 76rpx;
  font-size: 27rpx;
}

.accent-btn {
  background: linear-gradient(135deg, #ef5746 0%, #f59d34 100%);
}
